# Copy to .env.local and fill in. .env.local is gitignored, never commit real keys.
#
# NOTE: this list was derived from CLAUDE.md section 2 (stack) and section 7
# (adapter boundaries), because SETUP.md is not present in this repo. Reconcile
# it against SETUP.md section 3 when that file lands.

# --- Site ---
# Absolute origin of the deployment, used for auth redirects and email links.
NEXT_PUBLIC_SITE_URL=
# Email address that receives the owner magic link and message alerts.
OWNER_EMAIL=

# --- Supabase ---
# Project URL from Supabase dashboard, Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Anon public key, safe in the browser, RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key, server only, bypasses RLS, never import into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=
# Personal access token for the Supabase CLI, only needed for db:push and db:types in CI.
SUPABASE_ACCESS_TOKEN=

# --- Stripe ---
# Publishable key for Stripe Checkout redirect on the client.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret key used server side to create Checkout sessions.
STRIPE_SECRET_KEY=
# Signing secret for the Stripe webhook route handler.
STRIPE_WEBHOOK_SECRET=

# --- BOX NOW shipping ---
# API base URL, differs between BOX NOW sandbox and production.
BOXNOW_API_BASE_URL=
# OAuth client id issued by BOX NOW.
BOXNOW_CLIENT_ID=
# OAuth client secret issued by BOX NOW.
BOXNOW_CLIENT_SECRET=
# Partner id that identifies this shop on BOX NOW parcels.
BOXNOW_PARTNER_ID=
# Shared secret used to verify the BOX NOW tracking webhook.
BOXNOW_WEBHOOK_SECRET=

# --- Bank transfer payment method ---
# Account holder name shown to the buyer on the bank transfer instructions.
BANK_TRANSFER_ACCOUNT_NAME=
# IBAN shown to the buyer on the bank transfer instructions.
BANK_TRANSFER_IBAN=
# BIC or SWIFT code shown to the buyer on the bank transfer instructions.
BANK_TRANSFER_BIC=

# --- Resend email ---
# API key for sending order confirmations and message alerts.
RESEND_API_KEY=
# Verified sender address, must be on a domain verified in Resend.
RESEND_FROM_EMAIL=
