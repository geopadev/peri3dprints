# Copy to .env.local and fill in. .env.local is gitignored, never commit real keys.
#
# This is the list from SETUP.md section 3, in the same order. Vercel uses the
# same names with different values, and preview must point at the dev Supabase
# project and Stripe test keys.
#
# The WhatsApp number is not here on purpose. It lives in the settings table so
# the client can change it himself without a redeploy.

# --- Site ---
# Absolute origin of this deployment. Use http://localhost:3000 for local dev.
NEXT_PUBLIC_SITE_URL=

# --- Supabase ---
# Project URL, from the dashboard under Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Anon public key, safe in the browser because RLS still applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key. Bypasses RLS entirely, server only, never in a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---
# Secret key, used server side to create Checkout sessions.
STRIPE_SECRET_KEY=
# Signing secret for the webhook route. The local and production values differ.
STRIPE_WEBHOOK_SECRET=

# --- Email ---
# Resend API key, for order confirmations and message alerts.
RESEND_API_KEY=
# Sender, formatted as: Shop name <orders@yourdomain.com>. Domain must be verified in Resend.
EMAIL_FROM=
# Where the owner magic link and new message alerts are sent.
OWNER_EMAIL=

# --- BOX NOW (leave empty until the partner account exists, the app must still boot) ---
# Partner id that identifies this shop. Public because the locker map widget reads it.
NEXT_PUBLIC_BOXNOW_PARTNER_ID=
# API base URL. Sandbox and production are different hosts.
BOXNOW_API_URL=
# OAuth2 client id issued by BOX NOW.
BOXNOW_CLIENT_ID=
# OAuth2 client secret issued by BOX NOW.
BOXNOW_CLIENT_SECRET=
